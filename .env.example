# CineStream Environment Configuration Example
FLASK_SECRET_KEY=cinestream-super-secret-key-change-in-production
FLASK_ENV=development
PORT=5000

# Optional: TMDB API Key for live poster and title fetching
TMDB_API_KEY=

# Optional: AI Movie Assistant Provider (local | openai | anthropic)
# Default is 'local' (works offline with zero keys)
ASSISTANT_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
